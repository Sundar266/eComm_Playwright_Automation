{
  "name": "ecomm_playwright_automation",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "auth:setup": "playwright test auth-setup/auth.setup.js --project=setup",
    "test:dashboard": "playwright test tests/dashboard.test.spec.js --project=windows-chrome",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "allure:clean": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"Remove-Item allure-results -Recurse -Force -ErrorAction SilentlyContinue; New-Item allure-results -ItemType Directory -Force | Out-Null\"",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:generate:open": "npm run allure:generate && npm run allure:open"
  },
  "keywords": [],
  "author": "Sundar",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.11.0",
    "dotenv": "^17.4.2",
    "js-yaml": "^5.4.1",
    "oracledb": "^7.0.1"
  },
  "dependencies": {
    "csv-parse": "^7.0.2",
    "pdf-parse": "^2.4.5",
    "xlsx": "^0.18.5"
  }
}

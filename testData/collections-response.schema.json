{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Collections Response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "data"
  ],
  "properties": {
    "data": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "project_id",
          "user_id",
          "name",
          "slug",
          "schema",
          "visibility",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "project_id": {
            "type": "integer"
          },
          "user_id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "schema": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": true,
            "properties": {
              "name": {
                "type": "string"
              },
              "price": {
                "type": "string"
              },
              "category": {
                "type": "string"
              },
              "in_stock": {
                "type": "string"
              }
            }
          },
          "visibility": {
            "type": "string",
            "enum": [
              "private",
              "public"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
